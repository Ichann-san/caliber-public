# FE must show the selected mode. Never silently fall back after an API error.
# Inlined into the client bundle at BUILD time: production builds use "api".
NEXT_PUBLIC_DATA_SOURCE=mock
# Server-only secret. Do not put secrets in NEXT_PUBLIC variables.
# Local: npm run db:local generates a random password in ignored .env.local.
DATABASE_URL=postgresql://caliber:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/caliber_demo
# Hosted PostgreSQL (Azure Flexible Server, Neon, ...): require TLS, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/caliber_demo?sslmode=require
